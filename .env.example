# ==============================================================================
# TENDERS.TN - TEMPLATE DE CONFIGURATION
# ==============================================================================
# Copier ce fichier en .env et remplir avec vos vraies valeurs
# cp .env.example .env

# ---- Environnement ----
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---- Serveur ----
APP_BASE_URL=https://votre-domaine.com
ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# ---- Meta WhatsApp Cloud API ----
META_PHONE_NUMBER_ID=your_phone_number_id
META_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PROVIDER=meta

# ---- Green-API (Secours automatique) ----
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_green_api_token

# ---- Webhook Meta ----
META_VERIFY_TOKEN=your_webhook_verify_token

# ---- Paiement (Konnect / Flouci) ----
KONNECT_API_KEY=your_konnect_api_key
KONNECT_WALLET_ID=your_wallet_id

# ---- Sécurité ----
ADMIN_SECRET_KEY=changez_cette_cle_aleatoire_32_caracteres
JWT_SECRET_KEY=changez_cette_cle_jwt_aleatoire_64_caracteres

# ---- Base de données ----
DB_PATH=tenders.db

# ---- Planification ----
SYNC_INTERVAL_MINUTES=30
MORNING_BRIEFING_HOUR=8
